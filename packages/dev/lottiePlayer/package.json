{
    "name": "@dev/lottie-player",
    "private": true,
    "version": "1.0.0",
    "types": "dist/index",
    "main": "dist/index",
    "module": "dist/index",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./local": {
            "types": "./dist/local.d.ts",
            "default": "./dist/local.js"
        },
        "./worker": {
            "types": "./dist/worker.d.ts",
            "default": "./dist/worker.js"
        },
        "./package.json": "./package.json",
        "./*.js": "./dist/*.js",
        "./*.d.ts": "./dist/*.d.ts",
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        }
    },
    "type": "module",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "npm run compile",
        "test": "vitest run",
        "clean": "rimraf dist && rimraf *.tsbuildinfo -g",
        "precompile": "",
        "compile": "npm run compile:source",
        "compile:source": "tsc -b tsconfig.build.json",
        "watch:source": "tsc -b tsconfig.build.json -w",
        "watch": "build-tools -c dev-watch --packages \"lottie-player\" -wa"
    },
    "sideEffects": [
        "./src/rendering/babylonSideEffects.ts"
    ],
    "devDependencies": {
        "@dev/core": "^1.0.0",
        "@dev/build-tools": "^1.0.0"
    }
}
